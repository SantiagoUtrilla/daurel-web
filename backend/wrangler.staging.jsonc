{
  // Configuración ÚNICAMENTE de pruebas. Nunca apuntar a daurel-db.
  "name": "daurel-backend-staging",
  "main": "./staging/worker.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  // Un disparador diario, sin mensajes hasta activar secretos opt-in.
  "triggers": { "crons": ["0 15 * * *"] },
  "vars": {
    "ENVIRONMENT": "staging",
    "AUTH_EMAIL_FROM": "acceso@daurel.com.mx"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daurel-staging",
      "database_id": "9a10d215-203b-438c-afae-049b29a57e58",
      "migrations_dir": "migrations"
    }
  ]
}
